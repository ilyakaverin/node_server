# Скопируйте в .env (в корне проекта) и заполните.

# SMTP-сервер для отправки писем
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# true — TLS сразу (обычно порт 465), false — STARTTLS (обычно 587)
SMTP_SECURE=true
SMTP_USER=robot@example.com
SMTP_PASS=

# Отправитель (по умолчанию SMTP_USER) и получатели через запятую
MAIL_FROM=
MAIL_TO=first@example.com,second@example.com

# Необязательно: пути к базе и конфигурации разделов.
# Относительные пути считаются от корня проекта.
# DB_PATH=database.json
# CONFIG_PATH=configuration/resources.json
